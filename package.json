{
  "name": "rspack-module-federation",
  "version": "1.0.0",
  "private": true,
  "description": "Module federation using rspack",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter \"./packages/**\" --parallel --stream -r dev",
    "dev:app": "pnpm --filter \"./apps/**\" --parallel --stream -r dev",
    "dev:app:1.5": "pnpm dev:app --mf=v1.5",
    "dev:app:2": "pnpm dev:app --mf=v2",
    "build:app": "pnpm --filter \"./apps/**\" --parallel -r build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20.18.1"
  },
  "packageManager": "pnpm@8.15.0",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
